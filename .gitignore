# Your own game files: never commit ROMs, in-game saves or save states
# (save states hold the game's memory and graphics).
input/
states/
*.gb
*.gbc
*.sgb
*.ram
*.ram.bak
*.sav
*.state

# Screenshots and renders of the games
out/

# Python
.venv/
__pycache__/
*.pyc

# solved areas kept between sessions (ugb.render: rebuilt when the code changes)
cache/

# the packaged app (tools/build_windows.py)
build/
dist/
*.spec
